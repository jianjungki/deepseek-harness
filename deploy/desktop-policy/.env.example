# Public HTTPS origin of this service. Zitadel must allow the callback below.
PUBLIC_ORIGIN=https://policy.example.com

# Zitadel instance origin and OIDC application credentials.
ZITADEL_ISSUER=https://your-tenant.zitadel.cloud
ZITADEL_CLIENT_ID=replace-with-zitadel-client-id
# Optional for a public/native client using PKCE. Leave blank when Zitadel gives no secret.
ZITADEL_CLIENT_SECRET=
# Defaults to PUBLIC_ORIGIN followed by /oauth/callback.
ZITADEL_REDIRECT_URI=

# At least 32 random characters. Keep this stable across replicas.
SESSION_SECRET=replace-with-at-least-32-random-characters

HOST=0.0.0.0
PORT=8787

# A client is blocked when either Desktop or bundled dsh version is below this value.
# Leave empty to return the no-force response for every valid client.
MIN_DESKTOP_VERSION=0.1.7-rc.2
POLICY_PLATFORM=all
POLICY_ARCH=all
POLICY_CHANNEL=nightly

# This URL must remain on an origin allowed by the Desktop package.
DOWNLOAD_PAGE_URL=

UPDATE_TITLE_ZH=请更新 DeepSeek Harness
UPDATE_DETAIL_ZH=当前版本已停止支持，请下载并安装新版本。
UPDATE_TITLE_EN=Update DeepSeek Harness
UPDATE_DETAIL_EN=This version is no longer supported. Download and install the latest version.
